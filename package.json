{
  "name": "harbor-desktop",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm run dev -w @harbor/companion\" \"npm run dev -w @harbor/ui\"",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=22" }
}
